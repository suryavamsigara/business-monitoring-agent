# Supabase API credentials (optional - only needed if you call Supabase's
# REST/Auth APIs directly; the backend talks to Postgres via DATABASE_URL)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Postgres/Supabase connection string. Falls back to local SQLite if unset.
# Example Supabase: postgresql://postgres:[password]@[project].supabase.co:5432/postgres
DATABASE_URL=

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How often the scheduler runs the monitoring cycle
AGENT_INTERVAL_MINUTES=15

# Minimum time before the same alert can re-notify unless severity worsens
ALERT_COOLDOWN_MINUTES=120